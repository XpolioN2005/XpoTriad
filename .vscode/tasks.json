{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build XpoTriad (PowerShell)",
			"type": "shell",
			"command": "powershell -NoProfile -ExecutionPolicy Bypass -File ${workspaceFolder}/build.ps1",
			"options": {
				"cwd": "${workspaceFolder}",
				"shell": {
					"executable": "powershell.exe"
				}
			},
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "Build XpoTriad (bash)",
			"type": "shell",
			"command": "bash ${workspaceFolder}/build.sh",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build",
			"problemMatcher": []
		}
	]
}
